# Application
APP_ENV=local
APP_API_KEY=
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=postgresql+psycopg://scanalytics:scanalytics@db:5432/agents

# Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Model provider
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional outbound integration
OUTBOUND_WEBHOOK_TOKEN=
